# Generate each token independently; empty credentials intentionally prevent startup in Compose.
NODE_ADMIN_TOKEN=
NODE_READ_TOKEN=
# Comma-separated revision-2 peer addresses; do not use Bitcoin mainnet peers.
NODE_BOOTSTRAP=
# Base58-encoded Ed25519 public key, never a private key. Empty disables mining.
NODE_MINER_ADDRESSES=
NODE_READINESS_MIN_PEERS=1
NODE_MIN_FREE_DISK_BYTES=1073741824
